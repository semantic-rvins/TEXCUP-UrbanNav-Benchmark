+std::vector<GVINS::PriorStateBinding> GVINS::capturePriorStateBindings() const {
+    std::vector<PriorStateBinding> bindings;
+    for (size_t k = 0; k < last_marginalization_parameter_blocks_.size(); ++k) {
+        const double *block = last_marginalization_parameter_blocks_[k];
+        if (block == extrinsic_ || block == extrinsic_ + 7) {
+            continue;
+        }
+        size_t matches = 0;
+        for (const auto &state : statedatalist_) {
+            if (block == state.pose || block == state.mix) {
+                bindings.push_back({k, state.time, block == state.pose});
+                ++matches;
+            }
+        }
+        CHECK(matches == 1) << "Prior parameter must reference exactly one live state";
+    }
+    return bindings;
+}
+
+void GVINS::restorePriorStateBindings(const std::vector<PriorStateBinding> &bindings) {
+    auto remapped = last_marginalization_parameter_blocks_;
+    size_t changed = 0;
+    for (const auto &binding : bindings) {
+        CHECK(binding.block_index < remapped.size()) << "Prior parameter order changed during state update";
+        size_t matches = 0;
+        for (auto &state : statedatalist_) {
+            if (state.time == binding.time) {
+                double *block = binding.is_pose ? state.pose : state.mix;
+                changed += remapped[binding.block_index] != block;
+                remapped[binding.block_index] = block;
+                ++matches;
+            }
+        }
+        CHECK(matches == 1) << "State update removed or duplicated a prior-supported timestamp "
+                            << Logging::doubleData(binding.time);
+    }
+    last_marginalization_parameter_blocks_.swap(remapped);
+    if (changed) {
+        LOGI << "Rebound " << changed << " prior state blocks after state storage change";
+    }
+}
